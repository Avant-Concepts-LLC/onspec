{
  "name": "onspec",
  "version": "1.2.0",
  "description": "Specs that refuse to drift. Git-native verification layer for spec-driven development.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "onspec": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:junit": "vitest run --reporter=default --reporter=junit --outputFile=test-results.xml",
    "onspec": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test",
    "build:blog": "tsx scripts/build-blog.mts",
    "blog:draft": "tsx scripts/blog-draft.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/picomatch": "^4.0.3",
    "marked": "^18.0.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "spec",
    "spec-driven-development",
    "verification",
    "drift",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avant-Concepts-LLC/onspec.git"
  },
  "bugs": {
    "url": "https://github.com/Avant-Concepts-LLC/onspec/issues"
  },
  "homepage": "https://onspec.sh"
}
